{
  "name": "aim-trainer-by-vinay",
  "version": "1.0.0",
  "description": "Aim Trainer by Vinay",
  "main": "main.js",
  "author": "Vinay",
  "license": "MIT",
  "scripts": {
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vinay.aimtrainer",
    "productName": "Aim Trainer by Vinay",
    "asar": true,
    "files": [
      "aim.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Aim-Trainer-by-Vinay-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
